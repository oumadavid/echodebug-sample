# Copy this file to `.env` and set a real connection string to fix the
# intentional build failure in lib/db.ts.
#
#   copy .env.example .env
#
# next build evaluates this module at compile time, so the variable must
# exist in the environment when you run `npm run build`.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/echodebug?schema=public"
